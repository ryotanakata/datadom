{
  "name": "@datadomjs/datadom",
  "version": "1.0.2",
  "description": "A lightweight utility for retrieving DOM elements using custom data attributes.",
  "type": "module",
  "exports": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryotanakata/datadom.git"
  },
  "keywords": [
    "DOM",
    "data-attributes",
    "query-selector",
    "element-selector",
    "client-side",
    "browser",
    "vanilla-js",
    "no-dependency",
    "lightweight",
    "performance",
    "custom-attributes",
    "web-development",
    "front-end",
    "DOM-manipulation",
    "utility-function"
  ],
  "author": "ryotanakata",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryotanakata/datadom/issues"
  },
  "homepage": "https://github.com/ryotanakata/datadom#readme",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
